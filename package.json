{
  "name": "dob-fill-ultra",
  "version": "1.0.0",
  "description": "DOB Brute Force Tool - Ultra Version",
  "main": "mainUltra.js",
  "build": {
    "appId": "com.yourcompany.dobfill.ultra",
    "productName": "dob-fill_ultra",
    "files": [
      "**/*"
    ],
    "extraResources": [
      "modules/",
      "utils/",
      "node_modules/playwright/.local-browsers/"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}.${ext}"
    }
  },
  "scripts": {
    "start": "electron .",
    "start-original": "electron main.js",
    "start-optimized": "electron mainOptimized.js",
    "start-ultra": "electron mainUltra.js",
    "dist": "electron-builder",
    "test": "node test-csrf.js",
    "test-playwright": "node test-playwright.js",
    "test-performance": "node test-performance.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "fs-extra": "^11.1.1",
    "p-limit": "^6.2.0",
    "playwright": "^1.53.2",
    "puppeteer": "^21.5.2",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12",
    "electron": "^27.0.0"
  }
}
