{
  "name": "dob-fill",
  "version": "1.0.0",
  "description": "DOB Brute Force Tool",
  "main": "main.js",
  "build": {
    "appId": "com.yourcompany.dobfill",
    "productName": "DOB Fill Tool",
    "files": [
      "**/*"
    ],
    "extraResources": [
      "modules/",
      "utils/",
      "node_modules/playwright/.local-browsers/"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node test-csrf.js",
    "test-playwright": "node test-playwright.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "fs-extra": "^11.1.1",
    "p-limit": "^6.2.0",
    "playwright": "^1.53.2",
    "puppeteer": "^21.5.2",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12",
    "electron": "^27.0.0"
  }
}
